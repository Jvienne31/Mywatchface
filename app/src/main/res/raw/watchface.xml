<?xml version="1.0" encoding="utf-8"?>
<!-- Summit — cadran Watch Face Format, 438 x 438, Galaxy Watch8 Classic 46 mm. -->
<WatchFace width="438" height="438" clipShape="CIRCLE">
  <Metadata key="CLOCK_TYPE" value="DIGITAL" />
  <Metadata key="PREVIEW_TIME" value="14:08:21" />

  <UserConfigurations>
    <ColorConfiguration id="theme" displayName="cfg_theme" defaultValue="0">
      <ColorOption id="0" displayName="theme_sommet" colors="#5BE37A #2FD0C6" />
      <ColorOption id="1" displayName="theme_braise" colors="#FFB020 #FF3D00" />
      <ColorOption id="2" displayName="theme_arctique" colors="#52D9FF #2F6BFF" />
      <ColorOption id="3" displayName="theme_crepuscule" colors="#FF6FA5 #FFA83D" />
      <ColorOption id="4" displayName="theme_iris" colors="#B594FF #5A4BFF" />
      <ColorOption id="5" displayName="theme_corail" colors="#FF8A6B #FF3D6E" />
      <ColorOption id="6" displayName="theme_acide" colors="#D8FF3D #4FE08A" />
      <ColorOption id="7" displayName="theme_platine" colors="#EEF3F8 #8DA2B4" />
    </ColorConfiguration>
    <ListConfiguration id="police" displayName="cfg_font" defaultValue="0">
      <ListOption id="0" displayName="font_technique" icon="font_technique" />
      <ListOption id="1" displayName="font_etroite" icon="font_etroite" />
      <ListOption id="2" displayName="font_condensee" icon="font_condensee" />
      <ListOption id="3" displayName="font_digitale" icon="font_digitale" />
    </ListConfiguration>
    <BooleanConfiguration id="tiles" displayName="cfg_tiles" defaultValue="TRUE" />
    <BooleanConfiguration id="arc"   displayName="cfg_arc"   defaultValue="TRUE" />
    <BooleanConfiguration id="week"  displayName="cfg_week"  defaultValue="TRUE" />
  </UserConfigurations>

  <Scene>

    <!-- Fond -->
    <PartDraw x="0" y="0" width="438" height="438">
      <Ellipse x="0" y="0" width="438" height="438">
        <Fill color="#08090C" />
      </Ellipse>
    </PartDraw>

    <!-- Cadres des données : tuiles à bord courbe (R 210), PNG car WFF n'a pas de primitive Path -->
    <BooleanConfiguration id="tiles">
      <BooleanOption id="TRUE">
        <Group name="tiles_on" x="0" y="0" width="438" height="438">
        <PartImage x="10" y="90" width="134" height="68">
          <Image resource="tile_tl_normal" />
          <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartImage>
        <PartImage x="10" y="90" width="134" height="68" alpha="0">
          <Image resource="tile_tl_ambient" />
          <Variant mode="AMBIENT" target="alpha" value="255" />
        </PartImage>
        <PartImage x="294" y="90" width="134" height="68">
          <Image resource="tile_tr_normal" />
          <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartImage>
        <PartImage x="294" y="90" width="134" height="68" alpha="0">
          <Image resource="tile_tr_ambient" />
          <Variant mode="AMBIENT" target="alpha" value="255" />
        </PartImage>
        <PartImage x="4" y="166" width="118" height="96">
          <Image resource="tile_ml_normal" />
          <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartImage>
        <PartImage x="4" y="166" width="118" height="96" alpha="0">
          <Image resource="tile_ml_ambient" />
          <Variant mode="AMBIENT" target="alpha" value="255" />
        </PartImage>
        <PartImage x="316" y="166" width="118" height="96">
          <Image resource="tile_mr_normal" />
          <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartImage>
        <PartImage x="316" y="166" width="118" height="96" alpha="0">
          <Image resource="tile_mr_ambient" />
          <Variant mode="AMBIENT" target="alpha" value="255" />
        </PartImage>
        <PartImage x="10" y="272" width="134" height="64">
          <Image resource="tile_bl_normal" />
          <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartImage>
        <PartImage x="10" y="272" width="134" height="64" alpha="0">
          <Image resource="tile_bl_ambient" />
          <Variant mode="AMBIENT" target="alpha" value="255" />
        </PartImage>
        <PartImage x="294" y="272" width="134" height="64">
          <Image resource="tile_br_normal" />
          <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartImage>
        <PartImage x="294" y="272" width="134" height="64" alpha="0">
          <Image resource="tile_br_ambient" />
          <Variant mode="AMBIENT" target="alpha" value="255" />
        </PartImage>
        <PartDraw x="0" y="0" width="438" height="438">
          <Ellipse x="188" y="321" width="62" height="62">
            <Fill color="#141A20" />
          </Ellipse>
          <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>
        </Group>
      </BooleanOption>
      <BooleanOption id="FALSE">
        <Group name="tiles_off" x="0" y="0" width="438" height="438" />
      </BooleanOption>
    </BooleanConfiguration>

    <!-- Arc de batterie, de -44° à +44° -->
    <BooleanConfiguration id="arc">
      <BooleanOption id="TRUE">
        <PartDraw x="0" y="0" width="438" height="438">
          <Arc centerX="219" centerY="219" width="404" height="404"
               startAngle="-44" endAngle="44" direction="CLOCKWISE">
            <Stroke color="#1B232B" thickness="16" cap="ROUND" />
          </Arc>
          <Arc centerX="219" centerY="219" width="404" height="404"
               startAngle="-44" endAngle="44" direction="CLOCKWISE">
            <Stroke color="[CONFIGURATION.theme.1]" thickness="16" cap="ROUND">
                  <LinearGradient startX="17" startY="219" endX="421" endY="219"
                                  colors="[CONFIGURATION.theme]" positions="0 1" />
                </Stroke>
            <Transform target="endAngle" value="-44 + 88 * [BATTERY_PERCENT] / 100" />
          </Arc>
          <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>
      </BooleanOption>
      <BooleanOption id="FALSE">
        <Group name="arc_off" x="0" y="0" width="438" height="438" />
      </BooleanOption>
    </BooleanConfiguration>

    <!-- Niveau de batterie + libellé -->
    <PartText x="0" y="42" width="438" height="22">
      <Text align="CENTER">
        <Font family="chakrapetch_semibold" size="14" color="#E3EAF1">
        <Template><![CDATA[%d%%]]><Parameter expression="[BATTERY_PERCENT]" /></Template>
      </Font>
      </Text>
    </PartText>
    <PartText x="0" y="66" width="438" height="20">
      <Text align="CENTER">
        <Font family="chakrapetch_semibold" size="13" color="#8D9BA9" letterSpacing="5">ENJOY</Font>
      </Text>
    </PartText>

    <!-- Heures et minutes : une variante par police -->
    <ListConfiguration id="police">
      <ListOption id="0">
        <DigitalClock x="0" y="0" width="438" height="438">
          <TimeText format="hh" hourFormat="24" align="CENTER" x="0" y="84" width="438" height="102">
            <Font family="chakrapetch_semibold" size="112" color="#E3EAF1" />
          </TimeText>
          <TimeText format="mm" align="CENTER" x="0" y="186" width="438" height="102">
            <Font family="chakrapetch_semibold" size="112" color="[CONFIGURATION.theme.0]" />
          </TimeText>
        </DigitalClock>
      </ListOption>
      <ListOption id="1">
        <DigitalClock x="0" y="0" width="438" height="438">
          <TimeText format="hh" hourFormat="24" align="CENTER" x="0" y="84" width="438" height="102">
            <Font family="rajdhani_semibold" size="124" color="#E3EAF1" />
          </TimeText>
          <TimeText format="mm" align="CENTER" x="0" y="186" width="438" height="102">
            <Font family="rajdhani_semibold" size="124" color="[CONFIGURATION.theme.0]" />
          </TimeText>
        </DigitalClock>
      </ListOption>
      <ListOption id="2">
        <DigitalClock x="0" y="0" width="438" height="438">
          <TimeText format="hh" hourFormat="24" align="CENTER" x="0" y="84" width="438" height="102">
            <Font family="oswald_semibold" size="116" color="#E3EAF1" />
          </TimeText>
          <TimeText format="mm" align="CENTER" x="0" y="186" width="438" height="102">
            <Font family="oswald_semibold" size="116" color="[CONFIGURATION.theme.0]" />
          </TimeText>
        </DigitalClock>
      </ListOption>
      <ListOption id="3">
        <DigitalClock x="0" y="0" width="438" height="438">
          <TimeText format="hh" hourFormat="24" align="CENTER" x="0" y="84" width="438" height="102">
            <Font family="orbitron_semibold" size="86" color="#E3EAF1" />
          </TimeText>
          <TimeText format="mm" align="CENTER" x="0" y="186" width="438" height="102">
            <Font family="orbitron_semibold" size="86" color="[CONFIGURATION.theme.0]" />
          </TimeText>
        </DigitalClock>
      </ListOption>
    </ListConfiguration>

    <!-- La date n'est plus dupliquée ici : la complication 5 (bas gauche) l'affiche déjà ("21 sept."),
         ce doublon créait un fouillis de texte à côté de l'anneau des secondes. -->

    <!-- Jours de la semaine -->
    <BooleanConfiguration id="week">
      <BooleanOption id="TRUE">
        <Group name="week_on" x="0" y="0" width="438" height="438">
        <PartText x="120" y="388" width="18" height="16">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="11" color="#48525E" letterSpacing="1">D</Font>
          </Text>
        </PartText>
        <PartText x="150" y="388" width="18" height="16">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="11" color="#48525E" letterSpacing="1">L</Font>
          </Text>
        </PartText>
        <PartText x="180" y="388" width="18" height="16">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="11" color="#48525E" letterSpacing="1">M</Font>
          </Text>
        </PartText>
        <PartText x="210" y="388" width="18" height="16">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="11" color="#48525E" letterSpacing="1">M</Font>
          </Text>
        </PartText>
        <PartText x="240" y="388" width="18" height="16">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="11" color="#48525E" letterSpacing="1">J</Font>
          </Text>
        </PartText>
        <PartText x="270" y="388" width="18" height="16">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="11" color="#48525E" letterSpacing="1">V</Font>
          </Text>
        </PartText>
        <PartText x="300" y="388" width="18" height="16">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="11" color="#48525E" letterSpacing="1">S</Font>
          </Text>
        </PartText>
        <!-- Jour courant en couleur d'accent. [DAY_OF_WEEK] : 1 = dimanche. -->
        <Condition>
          <Expressions>
            <Expression name="jour_0"><![CDATA[[DAY_OF_WEEK] == 1]]></Expression>
          </Expressions>
          <Compare expression="jour_0">
            <PartText x="120" y="388" width="18" height="16">
              <Text align="CENTER">
                <Font family="chakrapetch_semibold" size="11" color="[CONFIGURATION.theme.0]" letterSpacing="1">D</Font>
              </Text>
            </PartText>
          </Compare>
        </Condition>
        <Condition>
          <Expressions>
            <Expression name="jour_1"><![CDATA[[DAY_OF_WEEK] == 2]]></Expression>
          </Expressions>
          <Compare expression="jour_1">
            <PartText x="150" y="388" width="18" height="16">
              <Text align="CENTER">
                <Font family="chakrapetch_semibold" size="11" color="[CONFIGURATION.theme.0]" letterSpacing="1">L</Font>
              </Text>
            </PartText>
          </Compare>
        </Condition>
        <Condition>
          <Expressions>
            <Expression name="jour_2"><![CDATA[[DAY_OF_WEEK] == 3]]></Expression>
          </Expressions>
          <Compare expression="jour_2">
            <PartText x="180" y="388" width="18" height="16">
              <Text align="CENTER">
                <Font family="chakrapetch_semibold" size="11" color="[CONFIGURATION.theme.0]" letterSpacing="1">M</Font>
              </Text>
            </PartText>
          </Compare>
        </Condition>
        <Condition>
          <Expressions>
            <Expression name="jour_3"><![CDATA[[DAY_OF_WEEK] == 4]]></Expression>
          </Expressions>
          <Compare expression="jour_3">
            <PartText x="210" y="388" width="18" height="16">
              <Text align="CENTER">
                <Font family="chakrapetch_semibold" size="11" color="[CONFIGURATION.theme.0]" letterSpacing="1">M</Font>
              </Text>
            </PartText>
          </Compare>
        </Condition>
        <Condition>
          <Expressions>
            <Expression name="jour_4"><![CDATA[[DAY_OF_WEEK] == 5]]></Expression>
          </Expressions>
          <Compare expression="jour_4">
            <PartText x="240" y="388" width="18" height="16">
              <Text align="CENTER">
                <Font family="chakrapetch_semibold" size="11" color="[CONFIGURATION.theme.0]" letterSpacing="1">J</Font>
              </Text>
            </PartText>
          </Compare>
        </Condition>
        <Condition>
          <Expressions>
            <Expression name="jour_5"><![CDATA[[DAY_OF_WEEK] == 6]]></Expression>
          </Expressions>
          <Compare expression="jour_5">
            <PartText x="270" y="388" width="18" height="16">
              <Text align="CENTER">
                <Font family="chakrapetch_semibold" size="11" color="[CONFIGURATION.theme.0]" letterSpacing="1">V</Font>
              </Text>
            </PartText>
          </Compare>
        </Condition>
        <Condition>
          <Expressions>
            <Expression name="jour_6"><![CDATA[[DAY_OF_WEEK] == 7]]></Expression>
          </Expressions>
          <Compare expression="jour_6">
            <PartText x="300" y="388" width="18" height="16">
              <Text align="CENTER">
                <Font family="chakrapetch_semibold" size="11" color="[CONFIGURATION.theme.0]" letterSpacing="1">S</Font>
              </Text>
            </PartText>
          </Compare>
        </Condition>
        </Group>
      </BooleanOption>
      <BooleanOption id="FALSE">
        <Group name="week_off" x="0" y="0" width="438" height="438" />
      </BooleanOption>
    </BooleanConfiguration>

    <!-- Complication 1 — Haut gauche -->
    <ComplicationSlot slotId="1" x="10" y="90" width="134" height="68"
                      supportedTypes="SHORT_TEXT LONG_TEXT RANGED_VALUE GOAL_PROGRESS WEIGHTED_ELEMENTS MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY" displayName="slot_tl">
      <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="SHORT_TEXT" />
      <BoundingRoundBox x="0" y="0" width="134" height="68" cornerRadius="18" />
      <Complication type="SHORT_TEXT">
        <PartImage x="59" y="8" width="16" height="16" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="0" y="28" width="134" height="30">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="23" color="#E3EAF1">
            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
          </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="LONG_TEXT">
        <PartImage x="59" y="8" width="16" height="16" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="0" y="28" width="134" height="30">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="23" color="#E3EAF1">
            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
          </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="RANGED_VALUE">
        <PartImage x="59" y="8" width="16" height="16" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="0" y="28" width="134" height="30">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="23" color="#E3EAF1">
            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
          </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="GOAL_PROGRESS">
        <PartImage x="59" y="8" width="16" height="16" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="0" y="28" width="134" height="30">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="23" color="#E3EAF1">
            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
          </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="WEIGHTED_ELEMENTS">
        <PartImage x="59" y="8" width="16" height="16" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="0" y="28" width="134" height="30">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="23" color="#E3EAF1">
            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
          </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="MONOCHROMATIC_IMAGE">
        <PartImage x="51" y="17" width="32" height="32" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
      </Complication>
      <Complication type="SMALL_IMAGE">
        <PartImage x="51" y="17" width="32" height="32">
          <Image resource="[COMPLICATION.SMALL_IMAGE]" />
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <!-- Complication 2 — Haut droite -->
    <ComplicationSlot slotId="2" x="294" y="90" width="134" height="68"
                      supportedTypes="SHORT_TEXT LONG_TEXT RANGED_VALUE GOAL_PROGRESS WEIGHTED_ELEMENTS MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY" displayName="slot_tr">
      <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY" defaultSystemProviderType="SHORT_TEXT" />
      <BoundingRoundBox x="0" y="0" width="134" height="68" cornerRadius="18" />
      <Complication type="SHORT_TEXT">
        <PartImage x="59" y="8" width="16" height="16" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="0" y="28" width="134" height="30">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="23" color="#E3EAF1">
            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
          </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="LONG_TEXT">
        <PartImage x="59" y="8" width="16" height="16" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="0" y="28" width="134" height="30">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="23" color="#E3EAF1">
            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
          </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="RANGED_VALUE">
        <PartImage x="59" y="8" width="16" height="16" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="0" y="28" width="134" height="30">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="23" color="#E3EAF1">
            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
          </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="GOAL_PROGRESS">
        <PartImage x="59" y="8" width="16" height="16" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="0" y="28" width="134" height="30">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="23" color="#E3EAF1">
            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
          </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="WEIGHTED_ELEMENTS">
        <PartImage x="59" y="8" width="16" height="16" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="0" y="28" width="134" height="30">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="23" color="#E3EAF1">
            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
          </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="MONOCHROMATIC_IMAGE">
        <PartImage x="51" y="17" width="32" height="32" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
      </Complication>
      <Complication type="SMALL_IMAGE">
        <PartImage x="51" y="17" width="32" height="32">
          <Image resource="[COMPLICATION.SMALL_IMAGE]" />
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <!-- Complication 3 — Jauge gauche -->
    <ComplicationSlot slotId="3" x="4" y="166" width="118" height="96"
                      supportedTypes="RANGED_VALUE GOAL_PROGRESS SHORT_TEXT LONG_TEXT WEIGHTED_ELEMENTS MONOCHROMATIC_IMAGE EMPTY" displayName="slot_ml">
      <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY" defaultSystemProviderType="RANGED_VALUE" />
      <BoundingRoundBox x="0" y="0" width="118" height="96" cornerRadius="18" />
      <Complication type="RANGED_VALUE">
        <PartDraw x="0" y="0" width="118" height="96">
          <Arc centerX="59" centerY="48" width="72" height="72" startAngle="0" endAngle="360">
            <Stroke color="#1B232B" thickness="6" />
          </Arc>
          <Arc centerX="59" centerY="48" width="72" height="72" startAngle="0" endAngle="360" direction="CLOCKWISE">
            <Stroke color="[CONFIGURATION.theme.0]" thickness="6" cap="ROUND">
                  <LinearGradient startX="23" startY="48" endX="95" endY="48"
                                  colors="[CONFIGURATION.theme]" positions="0 1" />
                </Stroke>
            <Transform target="endAngle"
                       value="360 * ([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN])
                              / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN])" />
          </Arc>
        </PartDraw>
        <PartImage x="52" y="26" width="15" height="15" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="0" y="41" width="118" height="30">
          <Text align="CENTER">
            <Font family="chakrapetch_semibold" size="22" color="#E3EAF1">
            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
          </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="SHORT_TEXT">
        <PartImage x="52" y="26" width="15" height="15" tintColor="#8D9BA9">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="0" y="41" width="118" height="30">
